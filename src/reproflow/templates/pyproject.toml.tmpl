[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{project_slug}}"
version = "0.1.0"
description = "{{description}}"
readme = "README.md"
requires-python = ">=3.9"
license = { text = "MIT" }
authors = [
  { name = "{{author_name}}", email = "{{author_email}}" },
]
dependencies = []

[project.optional-dependencies]
dev = ["pytest>=7", "reproflow"]

[tool.pytest.ini_options]
testpaths = ["tests"]
