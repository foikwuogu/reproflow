#!/usr/bin/env python3
"""03_qa.py — write data/processed/qa_report.txt: row counts at each stage,
join/match rates, range checks, and named spot checks. Every number that
will appear in any document must be traceable to this report or to
data/processed/stats.json."""
import json
from pathlib import Path

PROCESSED_DIR = Path(__file__).resolve().parents[1] / "data" / "processed"


def main() -> None:
    PROCESSED_DIR.mkdir(parents=True, exist_ok=True)
    report_lines = [
        "QA REPORT",
        "=========",
        "# Row counts at each stage: ...",
        "# Join/match rates: ...",
        "# Range and sanity checks: ...",
        "# Named spot checks (>=5 units): ...",
    ]
    (PROCESSED_DIR / "qa_report.txt").write_text("\n".join(report_lines) + "\n", encoding="utf-8")

    stats = {}  # every number any document will quote goes here
    (PROCESSED_DIR / "stats.json").write_text(json.dumps(stats, indent=2), encoding="utf-8")


if __name__ == "__main__":
    main()
