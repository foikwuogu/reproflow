#!/usr/bin/env python3
"""04_figures.py — build figures from data/processed/stats.json. Every
figure carries a DRAFT tag until run with --final."""
import argparse
import json
from pathlib import Path

STATS_PATH = Path(__file__).resolve().parents[1] / "data" / "processed" / "stats.json"
FIGURES_DIR = Path(__file__).resolve().parents[1] / "paper" / "figures"


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--final", action="store_true", help="remove DRAFT tag from figures")
    args = parser.parse_args()

    FIGURES_DIR.mkdir(parents=True, exist_ok=True)
    stats = json.loads(STATS_PATH.read_text(encoding="utf-8")) if STATS_PATH.exists() else {}
    draft = not args.final
    raise NotImplementedError(f"Build figures from {stats!r} here; draft={draft}.")


if __name__ == "__main__":
    main()
